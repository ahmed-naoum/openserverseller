# ============================================
# Silacod.ma - Environment Variables (TEMPLATE)
# ============================================
# Copy to .env and fill in real values. NEVER commit .env,
# and never put a real credential in this file.
# setup.sh substitutes the CHANGE_ME_* / YOUR_PASSWORD tokens below.
# ============================================

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/silacod_db"

# Server
NODE_ENV=development
PORT=3001
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5173

# Authentication
# Generate with: openssl rand -hex 32   (64 characters)
JWT_SECRET=CHANGE_ME_generate_a_64_char_random_string
JWT_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Redis (for BullMQ)
REDIS_URL=redis://localhost:6379

# SMTP / Email Config
SMTP_HOST=mail.silacod.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password_here
SMTP_SECURE=true
SMTP_FROM_EMAIL=mail@silacod.com
EMAIL_FROM=mail@silacod.com

# IMAP Config (for reference)
IMAP_HOST=mail.silacod.com
IMAP_PORT=143
IMAP_USER=your_imap_user
IMAP_PASS=your_imap_password_here

# Coliaty Delivery API
COLIATY_PUBLIC_KEY=your_coliaty_public_key_here
COLIATY_SECRET_KEY=your_coliaty_secret_key_here
COLIATY_BASE_URL=https://customer-api-v1.coliaty.com

# YouCan Integration API
YOUCAN_CLIENT_ID=your_youcan_client_id_here
YOUCAN_CLIENT_SECRET=your_youcan_client_secret_here
YOUCAN_API_URL=https://api.youcan.shop
YOUCAN_AUTH_URL=https://seller-area.youcan.shop/admin/oauth/authorize
YOUCAN_TOKEN_URL=https://seller-area.youcan.shop/oauth/token

# Encrypts bank account numbers (BankAccount.ribAccount) at rest.
# MUST be exactly 32 characters (aes-256-cbc key).
# Generate with: openssl rand -hex 16
# WARNING: changing this makes existing encrypted rows undecryptable.
ENCRYPTION_KEY=CHANGE_ME_generate_a_32_char_random_string

# Security
SECURITY_ENABLE_IP_BLOCKING=true
SECURITY_ENABLE_AUDIT_LOG=true
SECURITY_ENABLE_SANITIZATION=true

# DamaneSign E-Signature API
DAMANESIGN_API_URL=https://api-recette.damanesign.ma
DAMANESIGN_API_KEY=your_damanesign_api_key_here

# Cloudflare Turnstile
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here

# Cloudflare (For Custom Domain Management)
CLOUDFLARE_API_TOKEN="your_cloudflare_api_token_here"
CLOUDFLARE_ZONE_ID="your_cloudflare_zone_id_here"
CLOUDFLARE_FALLBACK_ORIGIN="custom.silacod.com"

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# Cloudinary (video upload)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# Google Sheets
GOOGLE_SHEETS_API_KEY=your_google_sheets_api_key_here
GOOGLE_SHEETS_READER_URL=
GOOGLE_OAUTH_ACCESS_TOKEN=

# Shopify
SHOPIFY_CLIENT_ID=your_shopify_client_id_here
SHOPIFY_CLIENT_SECRET=your_shopify_client_secret_here
SHOPIFY_API_KEY=your_shopify_api_key_here
SHOPIFY_API_SECRET=your_shopify_api_secret_here

# Twilio (SMS)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=

# WhatsApp Business
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_VERIFY_TOKEN=your_whatsapp_verify_token_here

# Instagram
IG_USERNAME=
IG_PASSWORD=your_instagram_password_here

# Business rules
PLATFORM_COMMISSION_PERCENTAGE=
MIN_PAYOUT_AMOUNT_MAD=
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
BCRYPT_SALT_ROUNDS=12

# Misc
SITE_NAME=SILACOD
API_BASE_URL=http://localhost:3001
ADMIN_NOTIFICATION_EMAIL=
JWT_REFRESH_EXPIRES_IN=30d
PG_DUMP_PATH=
PG_RESTORE_PATH=
EXTERNAL_LOG_STREAM_URL=
EXTERNAL_LOG_STREAM_API_KEY=
SECURITY_BLOCKED_IPS=
SECURITY_WHITELISTED_IPS=

# ============================================
# NOTE: every variable above except DATABASE_URL, ENCRYPTION_KEY and JWT_SECRET
# can also be set at runtime by a SUPER_ADMIN from the dashboard
# (Sécurité → Variables & Secrets). A value stored there takes precedence over
# the value in this file. Those three are required before the database can be
# read, so they must always come from .env.
# ============================================
