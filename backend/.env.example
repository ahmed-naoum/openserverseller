# ============================================
# Silacod.ma - Environment Variables
# Development Configuration
# ============================================

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:password123@localhost:5432/silacod_db"

# Server
NODE_ENV=development
PORT=3001
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5173

# Authentication
JWT_SECRET=dev_secret_key_change_in_production_64_chars_long_string_1234567890
JWT_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Redis (for BullMQ)
REDIS_URL=redis://localhost:6379

# SMTP / Email Config
SMTP_HOST=mail.silacod.com
SMTP_PORT=587
SMTP_USER=mailuser
SMTP_PASS=mailpassword123
SMTP_SECURE=true
SMTP_FROM_EMAIL=mail@silacod.com
EMAIL_FROM=mail@silacod.com

# IMAP Config (for reference)
IMAP_HOST=mail.silacod.com
IMAP_PORT=143
IMAP_USER=mailuser
IMAP_PASS=mailpassword123

# Coliaty Delivery API
COLIATY_PUBLIC_KEY=d6a76b7d7726efcdb4a4486261a1e2a0d2f7c8bac68c04af86f7c60c743fa118
COLIATY_SECRET_KEY=bdce0f4f4d7eb2493c29755a6b464712c791fbfd5131592a411285c45c8ed3bd
COLIATY_BASE_URL=https://customer-api-v1.coliaty.com

# YouCan Integration API
YOUCAN_CLIENT_ID=2498
YOUCAN_CLIENT_SECRET=QxrWfbY2MtX8zgxBHYT79mucnM4on9qa8AzLVHWV
YOUCAN_API_URL=https://api.youcan.shop
YOUCAN_AUTH_URL=https://seller-area.youcan.shop/admin/oauth/authorize
YOUCAN_TOKEN_URL=https://seller-area.youcan.shop/oauth/token

ENCRYPTION_KEY=7c8d9e0f1a2b3c4d5e6f7a8b9c0d1e2f

# Security
SECURITY_ENABLE_IP_BLOCKING=true
SECURITY_ENABLE_AUDIT_LOG=true
SECURITY_ENABLE_SANITIZATION=true

# DamaneSign E-Signature API
DAMANESIGN_API_URL=https://api-recette.damanesign.ma
DAMANESIGN_API_KEY=your_damanesign_api_key
