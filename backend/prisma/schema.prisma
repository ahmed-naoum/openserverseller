// Silacod.ma - PostgreSQL Production Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  guardName String   @default("web")
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model PasswordReset {
  id        Int      @id @default(autoincrement())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("password_resets")
}

model User {
  id       Int     @id @default(autoincrement())
  uuid     String  @unique @default(uuid())
  email    String? @unique
  phone    String? @unique
  password String
  roleId   Int
  role     Role    @relation(fields: [roleId], references: [id])

  // Seller-Affiliate mode switching
  mode String @default("SELLER") // SELLER, AFFILIATE

  // Influencer fields
  referralCode  String? @unique
  subdomain     String? @unique
  isInfluencer  Boolean @default(false)
  totalEarnings Float   @default(0)
  platformFeeRate Float @default(0.05)

  // Custom Domain Integration
  customDomain       String? @unique
  customDomainStatus String  @default("NONE") // NONE, PENDING, ACTIVE, FAILED
  customDomainCfId   String? // Cloudflare custom hostname ID

  isActive        Boolean   @default(false)
  kycStatus       String    @default("PENDING")
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  emailOtp        String?
  emailOtpExpiry  DateTime?
  lastLoginAt     DateTime?

  // 2FA and SSO
  twoFactorSecret    String?
  isTwoFactorEnabled Boolean @default(false)
  googleId           String? @unique
  canImpersonate     Boolean @default(false)
  mustChangePassword Boolean @default(false)
  requiresPasswordChange Boolean @default(false)
  autoAssignInfluencers Boolean @default(false)
  autoAssignHelperUsers Boolean @default(false)
  autoAssignHelperVendors Boolean @default(false)
  autoAssignHelperInfluencers Boolean @default(false)
  saisieFeeMad          Float   @default(8.0)
  canManageProducts     Boolean @default(false)
  canManageLeads        Boolean @default(false)
  canManageOrders       Boolean @default(false)
  canManageInfluencerLinks Boolean @default(false)
  canManageTickets       Boolean @default(false)
  canScanReturns         Boolean @default(false)
  canManageAffiliateInvites Boolean @default(false)
  helperCommissionPerDeliveredLead Float @default(5.0)
  canDisplayOnDashboard  Boolean @default(true)
  // When true, a lead created from this seller/influencer's Express Checkout is
  // automatically forwarded to the call center (status AVAILABLE) on arrival.
  autoSendLeadsToCallCenter Boolean @default(false)

  // Tracking
  registrationIp String?
  detectedCity   String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Contract Status
  contractAccepted Boolean   @default(false)
  contractSignedAt DateTime?
  cguAccepted      Boolean   @default(false)
  cguAcceptedAt    DateTime?
  damanesignTransactionId String?
  damanesignMemberId      String?
  damanesignFileId         String?
  damanesignSignedFileUrl  String?

  // YouCan Integration
  youcanAccessToken String?
  youcanStoreDomain String?
  youcanSyncActive  Boolean   @default(true)
  youcanConnectedAt DateTime?

  // Shopify Integration
  shopifyAccessToken String?
  shopifyStoreDomain String?
  shopifySyncActive  Boolean   @default(true)
  shopifyConnectedAt DateTime?

  // WooCommerce Integration
  wooCommerceUrl            String?
  wooCommerceConsumerKey    String?
  wooCommerceConsumerSecret String?
  wooCommerceSyncActive     Boolean   @default(true)
  wooCommerceConnectedAt    DateTime?

  // Google Sheets Integration
  googleSheetUrl        String?
  googleSheetId         String?
  googleSheetSyncActive Boolean   @default(true)
  googleSheetConnectedAt DateTime?
  googleSheetWebhookToken String? @unique

  language       String            @default("ar") @db.VarChar(5)

  profile        UserProfile?
  questionnaire  SellerQuestionnaire?
  influencerQuestionnaire InfluencerQuestionnaire?
  kycDocuments   KycDocument[]
  leadImports    LeadImportBatch[]
  leads          Lead[]
  assignedLeads  Lead[]            @relation("AgentLeads")
  orders         Order[]
  wallet         Wallet?
  payoutRequests PayoutRequest[]   @relation("VendorPayouts")
  notifications  Notification[]

  ownedProducts   Product[]          @relation("ProductOwner")
  inventory       ProductInventory[]
  claims          AffiliateClaim[]
  supportRequests SupportRequest[]
  customProductRequests CustomProductRequest[]

  conversations ConversationParticipant[]
  claimedConversations Conversation[] @relation("ClaimedConversations")
  messages      Message[]
  activityLogs  ActivityLog[]

  // Agent/Lead management relations
  leadStatusHistories LeadStatusHistory[]
  callLogs            CallLog[]
  leadAssignments     LeadAssignment[]

  // Influencer relations
  referralLinks ReferralLink[]
  commissions   InfluencerCommission[]

  // Agent-Influencer assignment relations
  agentAssignments      AgentInfluencerAssignment[] @relation("AgentAssignments")
  influencerAssignments AgentInfluencerAssignment[] @relation("InfluencerAssignments")

  // Helper-User assignment relations
  helperAssignments      HelperUserAssignment[] @relation("HelperAssignments")
  targetUserAssignments  HelperUserAssignment[] @relation("TargetUserAssignments")

  orderStatusHistories OrderStatusHistory[]
  productionJobs       ProductionJob[]
  favorites            Favorite[]
  targetedAnnouncements Announcement[]     @relation("TargetedAnnouncements")
  bankAccounts         UserBankAccount[]
  invoices             Invoice[]
  conversationLogs     ConversationLog[]  @relation("UserLogs")
  pixels               UserPixel[]

  @@map("users")
}

model UserBankAccount {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankName     String
  ribAccount   String
  iceNumber    String?
  status       String   @default("PENDING") // PENDING, APPROVED, REJECTED
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("user_bank_accounts")
}

model UserProfile {
  userId    Int     @id
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName  String?
  avatarUrl String?
  city      String?
  address   String?
  cinNumber String?
  birthDate DateTime?
  language  String  @default("fr")
  metadata  Json?

  // Influencer Specific
  instagramUsername  String?
  instagramFollowers Int?
  tiktokUsername     String?
  facebookUsername   String?
  xUsername          String?
  youtubeUsername    String?
  snapchatUsername   String?

  @@map("user_profiles")
}

model KycDocument {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id])
  documentType String
  documentUrl  String
  status       String   @default("PENDING")
  metadata     Json?
  createdAt    DateTime @default(now())

  @@map("kyc_documents")
}



model Category {
  id       Int        @id @default(autoincrement())
  nameAr   String
  nameFr   String
  nameEn   String?
  parentId Int?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  slug     String     @unique
  imageUrl String?
  products Product[]

  @@map("categories")
}

model Product {
  id              Int     @id @default(autoincrement())
  sku             String  @unique
  ref             String? @unique // URL-friendly reference string
  nameAr          String
  nameFr          String
  nameEn          String?
  description     String?
  longDescription String? // Rich HTML content

  categories Category[] // Implicit M-To-M relation

  baseCostMad        Float
  retailPriceMad     Float
  affiliatePriceMad  Float?
  influencerPriceMad Float?
  isCustomizable     Boolean @default(true)
  minProductionDays  Int     @default(3)
  stockQuantity      Int     @default(0)
  stockStatus        String  @default("available") // "available", "out_of_stock", "pre_order"

  // Downloads and Links
  ficheTechniqueUrl  String?
  canvaLink         String?
  mockupLink        String?

  // Arch modifications
  ownerId         Int?
  owner           User?    @relation("ProductOwner", fields: [ownerId], references: [id])
  visibility      String[] @default(["REGULAR"]) // REGULAR, AFFILIATE, INFLUENCER, NONE
  status          String   @default("APPROVED") // PENDING, APPROVED, REJECTED
  videoUrls       String[] @default([])
  landingPageUrls String[] @default([])
  commissionMad           Float    @default(0) // Affiliate commission per sale in MAD
  influencerCommissionMad Float    @default(0) // Influencer commission per sale in MAD

  isActive  Boolean  @default(true)
  showInHomepage Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images               ProductImage[]
  orderItems           OrderItem[]
  inventories          ProductInventory[]
  warehouseInventories Inventory[]
  claims               AffiliateClaim[]
  referralLinks        ReferralLink[]
  supportRequests      SupportRequest[]
  wholesalePrices      WholesalePriceTier[]
  favorites            Favorite[]

  @@map("products")
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  imageUrl  String
  isPrimary Boolean @default(false)
  sortOrder Int     @default(0)

  @@map("product_images")
}

model WholesalePriceTier {
  id           Int      @id @default(autoincrement())
  productId    Int
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  minQuantity  Int
  maxQuantity  Int
  pricePerUnit Float
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("wholesale_price_tiers")
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@map("favorites")
}

model PlatformSettings {
  id        Int      @id @default(autoincrement())
  key       String   @unique // e.g. "site_name", "fees", "media"
  value     Json
  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

model LeadImportBatch {
  id            Int      @id @default(autoincrement())
  vendorId      Int
  vendor        User     @relation(fields: [vendorId], references: [id])
  fileName      String
  totalRows     Int      @default(0)
  validRows     Int      @default(0)
  duplicateRows Int      @default(0)
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())

  leads Lead[]

  @@map("lead_import_batches")
}

model Lead {
  id              Int              @id @default(autoincrement())
  vendorId        Int
  vendor          User             @relation(fields: [vendorId], references: [id])
  importBatchId   Int?
  importBatch     LeadImportBatch? @relation(fields: [importBatchId], references: [id])
  fullName        String
  phone           String
  whatsapp        String?
  city            String?
  address         String?
  status          String           @default("NEW")
  paymentSituation String          @default("NOT_PAID") // NOT_PAID, PAID, FACTURED
  source          String           @default("MANUAL") // MANUAL, YOUCAN, etc.
  sourceId        String? // External ID from YouCan or other systems
  sourceMode      String           @default("VENDOR") // VENDOR, AFFILIATE
  assignedAgentId Int?
  assignedAgent   User?            @relation("AgentLeads", fields: [assignedAgentId], references: [id])
  productVariant  String?
  notes           String?
  callbackAt      DateTime?
  requestedPriceMad Float?
  requestedPriceStatus String? @default("PENDING") // PENDING, APPROVED, REJECTED
  customPlatformFeeRate Float?
  customShippingFee     Float?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  order          Order?
  referralLinkId Int?
  referralLink   ReferralLink?       @relation(fields: [referralLinkId], references: [id])
  invoiceId      Int?
  invoice        Invoice?            @relation(fields: [invoiceId], references: [id])
  statusHistory  LeadStatusHistory[]
  callLogs       CallLog[]
  assignments    LeadAssignment[]

  @@map("leads")
}

model LeadStatusHistory {
  id        Int      @id @default(autoincrement())
  leadId    Int
  lead      Lead     @relation(fields: [leadId], references: [id])
  oldStatus String
  newStatus String
  changedBy Int
  changer   User     @relation(fields: [changedBy], references: [id])
  notes     String?
  createdAt DateTime @default(now())

  @@map("lead_status_history")
}

model CallLog {
  id                  Int      @id @default(autoincrement())
  leadId              Int
  lead                Lead     @relation(fields: [leadId], references: [id])
  agentId             Int
  agent               User     @relation(fields: [agentId], references: [id])
  callDurationSeconds Int?
  outcome             String // ANSWERED, NO_ANSWER, BUSY, etc.
  recordingUrl        String?
  notes               String?
  createdAt           DateTime @default(now())

  @@map("call_logs")
}

model LeadAssignment {
  id           Int       @id @default(autoincrement())
  leadId       Int
  lead         Lead      @relation(fields: [leadId], references: [id])
  agentId      Int
  agent        User      @relation(fields: [agentId], references: [id])
  assignedAt   DateTime  @default(now())
  unassignedAt DateTime?

  @@map("lead_assignments")
}

model Order {
  id               Int      @id @default(autoincrement())
  orderNumber      String   @unique
  vendorId         Int
  vendor           User     @relation(fields: [vendorId], references: [id])
  leadId           Int?     @unique
  lead             Lead?    @relation(fields: [leadId], references: [id])
  customerName     String
  customerPhone    String
  customerCity     String
  customerAddress  String
  totalAmountMad   Float
  vendorEarningMad Float
  platformFeeMad   Float
  status              String   @default("PENDING")
  paymentMethod       String   @default("COD")
  coliatyPackageCode  String?
  coliatyPackageId    Int?
  coliatyPickupRef    String?
  packageContent      String?
  packageNoOpen       Boolean  @default(false)
  productVariant      String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  items                 OrderItem[]
  walletTransactions    WalletTransaction[]
  influencerCommissions InfluencerCommission[]
  statusHistory         OrderStatusHistory[]
  shipment              Shipment?
  returns               OrderReturn[]
  productionJobs        ProductionJob[]

  @@map("orders")
}

model OrderItem {
  id              Int                        @id @default(autoincrement())
  orderId         Int
  order           Order                      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       Int
  product         Product                    @relation(fields: [productId], references: [id])
  quantity        Int
  unitPriceMad    Float
  totalPriceMad   Float

  @@map("order_items")
}

model OrderStatusHistory {
  id            Int      @id @default(autoincrement())
  orderId       Int
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  oldStatus     String?
  newStatus     String
  changedBy     Int
  changedByUser User     @relation(fields: [changedBy], references: [id])
  notes         String?
  createdAt     DateTime @default(now())

  @@map("order_status_history")
}



model Warehouse {
  id        Int               @id @default(autoincrement())
  name      String
  location  String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  batches   ProductionBatch[]
  inventory Inventory[]

  @@map("warehouses")
}

model ProductionBatch {
  id          Int             @id @default(autoincrement())
  batchNumber String          @unique
  warehouseId Int
  warehouse   Warehouse       @relation(fields: [warehouseId], references: [id])
  status      String          @default("PENDING")
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  jobs        ProductionJob[]

  @@map("production_batches")
}

model ProductionJob {
  id           Int             @id @default(autoincrement())
  batchId      Int
  batch        ProductionBatch @relation(fields: [batchId], references: [id])
  orderId      Int
  order        Order           @relation(fields: [orderId], references: [id])
  status       String          @default("PENDING")
  assignedTo   Int?
  assignedUser User?           @relation(fields: [assignedTo], references: [id])
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime        @default(now())

  @@map("production_jobs")
}

model Inventory {
  id               Int       @id @default(autoincrement())
  warehouseId      Int
  warehouse        Warehouse @relation(fields: [warehouseId], references: [id])
  productId        Int
  product          Product   @relation(fields: [productId], references: [id])
  quantity         Int       @default(0)
  reservedQuantity Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([warehouseId, productId])
  @@map("inventories")
}

model Courier {
  id        Int        @id @default(autoincrement())
  name      String
  phone     String?
  email     String?
  isActive  Boolean    @default(true)
  shipments Shipment[]

  @@map("couriers")
}

model Shipment {
  id             Int                     @id @default(autoincrement())
  orderId        Int                     @unique
  order          Order                   @relation(fields: [orderId], references: [id])
  courierId      Int
  courier        Courier                 @relation(fields: [courierId], references: [id])
  trackingNumber String?                 @unique
  status         String                  @default("PENDING")
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  trackingEvents ShipmentTrackingEvent[]
  deliveryProof  ShipmentDeliveryProof?

  @@map("shipments")
}

model ShipmentTrackingEvent {
  id         Int      @id @default(autoincrement())
  shipmentId Int
  shipment   Shipment @relation(fields: [shipmentId], references: [id])
  status     String
  location   String?
  eventTime  DateTime @default(now())
  notes      String?

  @@map("shipment_tracking_events")
}

model ShipmentDeliveryProof {
  id         Int      @id @default(autoincrement())
  shipmentId Int      @unique
  shipment   Shipment @relation(fields: [shipmentId], references: [id])
  imageUrl   String
  signedBy   String?
  createdAt  DateTime @default(now())

  @@map("shipment_delivery_proofs")
}

model OrderReturn {
  id        Int      @id @default(autoincrement())
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id])
  reason    String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())

  @@map("order_returns")
}

model Wallet {
  id                Int      @id @default(autoincrement())
  userId            Int      @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balanceMad        Float    @default(0)
  totalEarnedMad    Float    @default(0)
  totalWithdrawnMad Float    @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id              Int      @id @default(autoincrement())
  walletId        Int
  wallet          Wallet   @relation(fields: [walletId], references: [id])
  type            String
  amountMad       Float
  balanceAfterMad Float
  description     String?
  orderId         Int?
  order           Order?   @relation(fields: [orderId], references: [id])
  createdAt       DateTime @default(now())

  @@map("wallet_transactions")
}

model PayoutRequest {
  id          Int       @id @default(autoincrement())
  vendorId    Int
  vendor      User      @relation("VendorPayouts", fields: [vendorId], references: [id])
  amountMad   Float
  status      String    @default("PENDING")
  bankName    String
  ribAccount  String
  iceNumber   String?
  processedAt DateTime?
  receiptUrl  String?
  createdAt   DateTime  @default(now())

  @@map("payout_requests")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("notifications")
}

model Announcement {
  id           Int      @id @default(autoincrement())
  type         String   // GLOBAL, ROLE, USER
  severity     String   @default("INFO") // INFO, WARNING, IMPORTANT
  priority     Int      @default(0)
  placement    String   @default("TOP")  // TOP, BOTTOM
  targetRole   String?  // e.g., 'VENDOR', 'INFLUENCER', 'AGENT'
  targetUserId Int?     
  targetUser   User?    @relation("TargetedAnnouncements", fields: [targetUserId], references: [id], onDelete: Cascade)
  title        String
  content      String   @db.Text
  actionUrl    String?
  actionText   String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("announcements")
}

model MoroccanCity {
  id      Int     @id @default(autoincrement())
  nameAr  String
  nameFr  String  @unique
  nameEn  String?
  region  String?
  isMajor Boolean @default(false)

  @@map("moroccan_cities")
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  modelType String?
  modelId   Int?
  changes   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@map("activity_logs")
}

model ProductInventory {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  productId  Int
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int      @default(0)
  acquiredAt DateTime @default(now())
  brandingLabelMockupUrl String?
  brandingLabelPrintUrl  String?

  updatedAt  DateTime @updatedAt

  @@map("product_inventory")
}

model AffiliateClaim {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED, REVOKED
  claimedAt DateTime @default(now())
  userMode  String   @default("AFFILIATE") // VENDOR or AFFILIATE
  brandingLabelMockupUrl String?
  brandingLabelPrintUrl  String?
  brandName              String?
  requestedQty           Int?
  requestedLandingPageUrl String?

  updatedAt DateTime @updatedAt

  @@unique([userId, productId, userMode])
  @@map("affiliate_claims")
}

model SupportRequest {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  type        String // DELIVERY_FULFILLMENT, PRODUCT_CLAIM, senior_SUPPORT, etc.
  subject     String
  description String
  status      String   @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  productId   Int?
  product     Product? @relation(fields: [productId], references: [id])
  brandingLabelMockupUrl String?
  brandingLabelPrintUrl  String?
  brandName              String?
  requestedQty           Int?
  requestedLandingPageUrl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  conversations Conversation[]

  @@map("support_requests")
}

// ==========================================
// CHAT & MESSAGING SYSTEM
// ==========================================

model Conversation {
  id        Int      @id @default(autoincrement())
  type      String   @default("DIRECT") // DIRECT, GROUP, SUPPORT
  title     String? // Optional for groups/support
  status    String   @default("ACTIVE") // ACTIVE, ARCHIVED, CLOSED, PENDING_CLAIM
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  claimedByUserId Int?
  claimedBy       User?           @relation("ClaimedConversations", fields: [claimedByUserId], references: [id])
  claimedAt       DateTime?
  metadata        Json?
  supportRequestId Int?
  supportRequest  SupportRequest? @relation(fields: [supportRequestId], references: [id])

  participants ConversationParticipant[]
  messages     Message[]
  logs         ConversationLog[]

  @@map("conversations")
}

model ConversationLog {
  id             Int          @id @default(autoincrement())
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         Int?
  user           User?        @relation("UserLogs", fields: [userId], references: [id])
  action         String       // CREATED, CLAIMED, CLOSED, etc.
  details        String?
  createdAt      DateTime     @default(now())

  @@map("conversation_logs")
}

model UserPixel {
  id              Int      @id @default(autoincrement())
  userId          Int
