  status           String   @default("OPEN") // OPEN, INVESTIGATING, RESOLVED
  eventDetails     Json?
  affectedIps      String[]
  recommendedSteps String?
  assignedAdminId  Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("security_incidents")
}

model SecurityAlertRule {
