// Google Sheets push credits. Mirrors Wallet field-for-field but Int, not Float,
// and with no `Mad` suffix: a credit is a whole-unit quantity (1 credit = 1 lead
// written into the seller's sheet), NOT money. Folding it into Wallet.balanceMad —
// every field of which is MAD-denominated — would read as a currency bug.
model SheetCreditAccount {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance       Int      @default(0)
  totalGranted  Int      @default(0)
  totalConsumed Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  transactions SheetCreditTransaction[]

  @@map("sheet_credit_accounts")
}

model SheetCreditTransaction {
  id           Int                @id @default(autoincrement())
  accountId    Int
  account      SheetCreditAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type         String // GRANT, CONSUME, ADMIN_DEBIT, REFUND
  amount       Int // signed: +n on a grant, -1 on a consume
  balanceAfter Int
  description  String?
  // THE double-charge guard, and the whole reason this column exists: one CONSUME
  // row per lead, enforced by Postgres rather than by application logic — the same
  // device as AgentInvoiceItem.leadId. Grants carry NULL here, and Postgres allows
  // many NULLs under a unique index, so they are unaffected.
  leadId       Int?               @unique
  lead         Lead?              @relation("SheetCreditCharge", fields: [leadId], references: [id], onDelete: SetNull)
  // Set when the row was covered by a monthly pack instead of by the cents
  // balance. Such a row carries `amount: 0` — the lead was paid for by the
  // subscription, not by the balance — so this column is the ONLY thing that
  // separates "covered by the pack" from "granted for free" in the ledger.
  // `type` stays CONSUME either way, deliberately: every predicate that means
  // "this lead has been paid for" already filters on CONSUME, and a new type
  // would have had to be added to each of them or leads would be charged twice.
  subscriptionId Int?
  subscription   SheetSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  createdBy    Int?
  createdAt    DateTime           @default(now())

  // `balanceAfter` is a running snapshot rather than just a delta because panels
  // read closing balances off the column instead of replaying the ledger — the
  // same reason WalletTransaction.balanceAfterMad exists.
  @@index([accountId, createdAt])
  // The finance panel asks "how many leads did this pack actually cover?", which
  // without this is a scan of the whole ledger.
  @@index([subscriptionId])
  @@map("sheet_credit_transactions")
}

/// A monthly pack a seller can be on instead of paying per lead.
///
/// The catalogue is a TABLE, not a constant, because the two prices the business
/// started with ($30 / 20k leads and $50 / 50k) are the kind of number that moves
/// twice a year, and a redeploy is the wrong unit of work for a price change.
/// `SheetSubscription` snapshots `priceCents` and `leadQuota` at approval, so
/// editing a plan never rewrites what an already-running subscription owes or gets.
model SheetPlan {
  id         Int     @id @default(autoincrement())
  /// Stable identifier used by the seeder and by anything that has to name one
  /// specific plan. The display name is free to change; this is not.
  code       String  @unique
  name       String
  /// What the pack costs per period, in CENTS — same unit as every other amount
  /// in this file. $30 is 3000.
  priceCents Int
  /// Leads the pack covers per period. Consumed leads draw from here BEFORE the
  /// cents balance, and the counter resets to zero on each renewal.
  leadQuota  Int
  /// Period length. 30 days rather than a calendar month so a subscription
  /// approved on the 31st has an unambiguous end date.
  periodDays Int     @default(30)
  /// Hidden from the seller's picker. Never deleted: subscriptions point here.
  active     Boolean @default(true)
  sortOrder  Int     @default(0)
  /// Shown under the price in the picker.
  description String?
  /// Accent colour for this pack's card, as `#rrggbb`. NULL means "use the
  /// default", so an untouched catalogue keeps the emerald it shipped with.
  ///
  /// Stored as a hex string rather than a Tailwind class name on purpose: Tailwind
  /// only emits classes it can see at BUILD time, so a class read out of the
  /// database would be purged and the card would render unstyled. The client turns
  /// this into inline styles instead. It is validated to `#rrggbb` on write —
  /// this value reaches a `style` attribute, so anything else is untrusted input.
  accentColor String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions SheetSubscription[]

  @@index([active, sortOrder])
  @@map("sheet_plans")
}

/// One seller's run on one pack — and, before that, their request to be put on it.
///
/// The seller creates the row as PENDING and an admin moves it to ACTIVE; there is
/// no payment gateway in this codebase, so approval IS the receipt. A row is only
/// ever ACTIVE for one account at a time (see services/sheetPlans.service.ts), and
/// `leadsUsed` is the whole billing state — it resets by a NEW row on renewal, not
/// by zeroing this one, so last month's consumption stays readable.
model SheetSubscription {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId Int
  plan   SheetPlan @relation(fields: [planId], references: [id])

  /// PENDING, ACTIVE, REJECTED, CANCELLED, EXPIRED
  status String @default("PENDING")

  /// Snapshots taken at APPROVAL, not at request: the admin approves the plan as
  /// it stands when they look at it, and nothing downstream re-reads SheetPlan.
  leadQuota  Int @default(0)
  priceCents Int @default(0)
  /// Leads this subscription has covered. Never exceeds `leadQuota` — the claim
  /// is a guarded UPDATE, not a read-then-write.
  leadsUsed  Int @default(0)

  requestedAt DateTime  @default(now())
  startedAt   DateTime?
  /// When the pack stops covering leads. Past this instant the account falls back
  /// to the per-lead tariff, whether or not the expiry cron has run yet — every
  /// read compares against the clock rather than trusting `status`.
  endsAt      DateTime?
  reviewedAt  DateTime?
  reviewedBy  Int?
  cancelledAt DateTime?
  /// The admin's reason on a rejection or a cancellation, shown to the seller.
  adminNote   String?
  /// What the seller typed when asking, so the admin has context to approve on.
  requestNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions SheetCreditTransaction[]

  /// The two predicates that matter: "this seller's current pack" and "which
  /// subscriptions has the expiry cron got to catch".
  @@index([userId, status])
  @@index([status, endsAt])
  @@map("sheet_subscriptions")
}

// The outbox. A lead is enqueued here on the request thread (one indexed SELECT
// plus one INSERT, no network) and a cron drains it, so Google being slow or down
// can never slow down or fail lead capture.
model SheetPushJob {
  id            Int       @id @default(autoincrement())
  vendorId      Int
  vendor        User      @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  // Makes enqueue idempotent: a retried landing-page POST or a double-clicked
  // agent insert cannot put the same lead in the seller's sheet twice.
  leadId        Int       @unique
  lead          Lead      @relation("SheetPushJobLead", fields: [leadId], references: [id], onDelete: Cascade)
  status        String    @default("PENDING") // PENDING, SENDING, SENT, BLOCKED_NO_CREDITS, FAILED, SKIPPED, REMOVED
  // REMOVED is the only value that is not about our own delivery: the row WAS
  // written, and it is no longer in the sheet because the seller deleted it by
  // hand. Nothing else in the outbound pipeline ever looks at the sheet again
  // after an append, so it is set by reconcileVendorSheet (services/sheetPush)
  // re-reading the Lead ID column, and flipped back to SENT if the row reappears.
  // Identifies WHICH drain run owns this row. The claim updateMany stamps it and
  // the follow-up read filters on it, so a runner can only ever append the rows it
  // actually won. Without it two overlapping drains re-read by status alone and
  // both append the same leads into the seller sheet.
  claimToken    String?
  origin        String    @default("AUTO") // AUTO, MANUAL
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lastError     String?
  sentAt        DateTime?
  sheetId       String?
  rowRange      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // The drain predicate, re-run every few seconds.
  @@index([status, nextAttemptAt])
  @@index([vendorId, createdAt])
  @@map("sheet_push_jobs")
}

