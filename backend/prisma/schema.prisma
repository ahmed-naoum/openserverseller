// Narrows an AgentInfluencerAssignment down to specific products of that
// influencer/vendor. No row for an assigned account = the agent works ALL of
// that account's leads (the historical behaviour); one or more rows = the agent
// only sees leads whose product is in that set.
model AgentProductAssignment {
  id           Int      @id @default(autoincrement())
  agentId      Int
  agent        User     @relation("AgentProductAssignments", fields: [agentId], references: [id], onDelete: Cascade)
  influencerId Int
  influencer   User     @relation("InfluencerProductAssignments", fields: [influencerId], references: [id], onDelete: Cascade)
  productId    Int
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  assignedAt   DateTime @default(now())

  @@unique([agentId, influencerId, productId])
  @@index([agentId])
  @@index([influencerId])
  @@map("agent_product_assignments")
}

// ==========================================
// VENDOR SUB-ACCOUNT PRODUCT ASSIGNMENT
// ==========================================

/**
 * Narrows one of a vendor's sub-accounts to part of the vendor's catalogue.
 * Same convention as AgentProductAssignment above: NO rows for a sub-account
 * means it works the whole catalogue — the behaviour that existed before this
 * table, so every helper already configured keeps the reach it had. Rows mean
 * "only these products", and everything downstream of a product (its links, its
 * leads, its orders) narrows with it.
 */
model VendorSubAccountProduct {
  id           Int      @id @default(autoincrement())
  subAccountId Int
  subAccount   User     @relation("SubAccountProducts", fields: [subAccountId], references: [id], onDelete: Cascade)
