  budget                String // allocated budget option
  ordersPerDay          String // shipping orders per day option
  experienceYears       String // experience option
  markets               Json // array of selected markets
  totalSpend            String // total eCommerce/ads spend option
  niches                Json // array of selected niches
  biggestAchievement    String // achievement option
  biggestChallenge      String // challenge option
  partnerPriorities     Json // array of selected priorities
  interviewAvailability String // "YES" or "NO"
  additionalNotes       String? // textarea notes
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("seller_questionnaires")
}

model InfluencerQuestionnaire {
