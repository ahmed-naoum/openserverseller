model TrafficLog {
  id             Int      @id @default(autoincrement())
  timestamp      DateTime @default(now())
  method         String   @db.VarChar(10)
  path           String
  status         Int
  ip             String   @db.VarChar(45)
  userAgent      String
  host           String   @db.VarChar(255)
  httpVersion    String   @db.VarChar(10)
  cached         Boolean  @default(false)
  encrypted      Boolean  @default(false)
  ssl            String   @db.VarChar(10)
  country        String   @db.VarChar(10)
  city           String?  @db.VarChar(100)
  latitude       Float?
  longitude      Float?
  bandwidth      Int      @default(0)
  referer        String   @default("Direct")
  browser        String   @db.VarChar(50)
  os             String   @db.VarChar(50)
  contentType    String   @db.VarChar(100)
  deviceType     String?  @db.VarChar(20)
  platform       String?  @db.VarChar(50)
  browserVersion String?  @db.VarChar(30)

  @@index([timestamp])
  @@index([status])
  @@index([ip])
  @@index([country])
  @@map("traffic_logs")
}

