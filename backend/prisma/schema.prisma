// Silacod.ma - PostgreSQL Production Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  guardName String   @default("web")
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model PasswordReset {
  id        Int      @id @default(autoincrement())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("password_resets")
}

model User {
  id       Int     @id @default(autoincrement())
  uuid     String  @unique @default(uuid())
  email    String? @unique
  phone    String? @unique
  password String
  roleId   Int
  role     Role    @relation(fields: [roleId], references: [id])

  // Seller-Affiliate mode switching
  mode String @default("SELLER") // SELLER, AFFILIATE

  // ------------------------------------------------------------------
  // VENDOR sub-accounts (role VENDOR_HELPER)
  //
  // A VENDOR can create helper accounts that log in with their own
  // credentials but operate on the *vendor's* data. The link below is what
  // authenticate() uses to swap the request identity over to the parent, so
  // every existing vendor-scoped query keeps working untouched.
  // ------------------------------------------------------------------
  parentVendorId Int?
  parentVendor   User?  @relation("VendorSubAccounts", fields: [parentVendorId], references: [id], onDelete: Cascade)
  subAccounts    User[] @relation("VendorSubAccounts")

  // Per-page grants for a sub-account. All default to false: a freshly created
  // helper can see nothing until its vendor explicitly hands over a page.
  subCanViewDashboard    Boolean @default(true)
  subCanViewLeads        Boolean @default(false)
  subCanEditLeads        Boolean @default(false)
  subCanCreateLeads      Boolean @default(false)
  subCanViewInventory    Boolean @default(false)
  subCanManageLinks      Boolean @default(false)
  subCanViewWallet       Boolean @default(false)
  subCanViewInvoices     Boolean @default(false)
  subCanViewIntegrations Boolean @default(false)
  subCanViewMarketplace  Boolean @default(false)
  subCanManageSupport    Boolean @default(false)
  subCanUseChat          Boolean @default(false)
  subCanManagePixels     Boolean @default(false)
  subCanManageDomains    Boolean @default(false)

  // Finer grants, each carved out of a broader one above because it is
  // destructive, costs money, or is visible to the customer.
  subCanDeleteLeads            Boolean @default(false)
  subCanPushToCallCenter       Boolean @default(false)
  subCanRespondPriceRequests   Boolean @default(false)
  subCanImportIntegrationLeads Boolean @default(false)
  subCanClaimProducts          Boolean @default(false)
  subCanEditProducts           Boolean @default(false)
  subCanRequestCustomProduct   Boolean @default(false)
  subCanCreateLinks            Boolean @default(false)
  subCanUseLinkBuilder         Boolean @default(false)
  subCanRegenerateLinks        Boolean @default(false)
  subCanViewTransactions       Boolean @default(false)
  subCanViewPayouts            Boolean @default(false)
  subCanViewCommissions        Boolean @default(false)
  subCanDownloadInvoices       Boolean @default(false)
  subCanViewPixels             Boolean @default(false)
  subCanCreateTickets          Boolean @default(false)
  subCanSendMessages           Boolean @default(false)
  subCanManageConversations    Boolean @default(false)
  subCanRefreshDomain          Boolean @default(false)

  // Optionally narrows a helper to part of the vendor's catalogue. NO rows means
  // the whole catalogue, so every sub-account created before this existed keeps
  // exactly the reach it had. See lib/subAccountProductScope.ts.
  subAccountProducts VendorSubAccountProduct[] @relation("SubAccountProducts")

  // Which of the two vendor modes this helper may sit in. SELLER | AFFILIATE | BOTH
  subAllowedModes    String    @default("BOTH")
  // Master switch: when true the helper can look at everything it was granted
  // but change nothing of the vendor's, whatever the grants above say.
  subReadOnly        Boolean   @default(false)
  // Optional end of access, for a temporary helper. Null means no expiry.
  subAccessExpiresAt DateTime?

  // Influencer fields
  referralCode    String? @unique
  subdomain       String? @unique
  isInfluencer    Boolean @default(false)
  totalEarnings   Float   @default(0)
  platformFeeRate Float   @default(0.05)

  // Custom Domain Integration
  customDomain       String? @unique
  customDomainStatus String  @default("NONE") // NONE, PENDING, ACTIVE, FAILED
  customDomainCfId   String? // Cloudflare custom hostname ID

  isActive        Boolean   @default(false)
  kycStatus       String    @default("PENDING")
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  emailOtp        String?
  emailOtpExpiry  DateTime?
  lastLoginAt     DateTime?

  // 2FA and SSO
  twoFactorSecret                  String?
  isTwoFactorEnabled               Boolean @default(false)
  googleId                         String? @unique
  canImpersonate                   Boolean @default(false)
  mustChangePassword               Boolean @default(false)
  requiresPasswordChange           Boolean @default(false)
  autoAssignInfluencers            Boolean @default(false)
  autoAssignHelperUsers            Boolean @default(false)
  autoAssignHelperVendors          Boolean @default(false)
  autoAssignHelperInfluencers      Boolean @default(false)
  saisieFeeMad                     Float   @default(8.0)
  // What a call-center agent nets per parcel they saisi that reached the
  // customer. Distinct from `saisieFeeMad`, which is what the vendor is billed
  // per lead entered — the two rates are set independently by an admin.
  netProfitPerDeliveredParcelMad   Float   @default(10.0)
  canManageProducts                Boolean @default(false)
  canManageLeads                   Boolean @default(false)
  canManageOrders                  Boolean @default(false)
  canManageInfluencerLinks         Boolean @default(false)
  canManageTickets                 Boolean @default(false)
  canScanReturns                   Boolean @default(false)
  canManageAffiliateInvites        Boolean @default(false)
  helperCommissionPerDeliveredLead Float   @default(5.0)
  canDisplayOnDashboard            Boolean @default(true)
  // When true, a lead created from this seller/influencer's Express Checkout is
  // automatically forwarded to the call center (status AVAILABLE) on arrival.
  autoSendLeadsToCallCenter        Boolean @default(false)

  // Tracking
  registrationIp String?
  detectedCity   String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Contract Status
  contractAccepted        Boolean   @default(false)
  contractSignedAt        DateTime?
  cguAccepted             Boolean   @default(false)
  cguAcceptedAt           DateTime?
  damanesignTransactionId String?
  damanesignMemberId      String?
  damanesignFileId        String?
  damanesignSignedFileUrl String?

  // YouCan Integration
  youcanAccessToken String?
  youcanStoreDomain String?
  youcanSyncActive  Boolean   @default(true)
  youcanConnectedAt DateTime?

  // Shopify Integration
  shopifyAccessToken String?
  shopifyStoreDomain String?
  shopifySyncActive  Boolean   @default(true)
  shopifyConnectedAt DateTime?

  // WooCommerce Integration
  wooCommerceUrl            String?
  wooCommerceConsumerKey    String?
  wooCommerceConsumerSecret String?
  wooCommerceSyncActive     Boolean   @default(true)
  wooCommerceConnectedAt    DateTime?

  // Google Sheets Integration
  googleSheetUrl          String?
  googleSheetId           String?
  googleSheetSyncActive   Boolean   @default(true)
  googleSheetConnectedAt  DateTime?
  googleSheetWebhookToken String?   @unique

  // Google Sheets — OUTBOUND (leads pushed INTO the seller's own sheet).
  // Deliberately separate from the googleSheet* fields above: that connection is
  // INBOUND and its sync DELETES rows it no longer sees (googleSheets.routes.ts,
  // parseAndInsertLeadRows). Pointing both directions at one spreadsheet would
  // re-import our own rows as leads and then wipe them, so connect refuses it.
  // `googleSheetsOutboundEnabled` is the admin-set entitlement that credits are
  // sold against; `googleSheetOutAuto` is the auto-push switch, which the admin
  // seeds and the seller can override — unlike autoSendLeadsToCallCenter, the
  // seller holds this one because the credits being spent are theirs.
  googleSheetsOutboundEnabled Boolean   @default(false)
  googleSheetOutUrl           String?
  googleSheetOutId            String?
  googleSheetOutTab           String?   @default("SILACOD Leads")
  googleSheetOutActive        Boolean   @default(true)
  googleSheetOutAuto          Boolean   @default(false)
  googleSheetOutConnectedAt   DateTime?
  googleSheetOutLastError     String?
  googleSheetOutLastErrorAt   DateTime?

  language String @default("ar") @db.VarChar(5)

  profile                 UserProfile?
  questionnaire           SellerQuestionnaire?
  influencerQuestionnaire InfluencerQuestionnaire?
  kycDocuments            KycDocument[]
  leadImports             LeadImportBatch[]
  leads                   Lead[]
  assignedLeads           Lead[]                   @relation("AgentLeads")
  leadContactClicks       LeadContactClick[]
  orders                  Order[]
  wallet                  Wallet?
  sheetCreditAccount      SheetCreditAccount?
  sheetPushJobs           SheetPushJob[]
  payoutRequests          PayoutRequest[]          @relation("VendorPayouts")
  notifications           Notification[]

  ownedProducts         Product[]              @relation("ProductOwner")
  inventory             ProductInventory[]
  claims                AffiliateClaim[]
  supportRequests       SupportRequest[]
  customProductRequests CustomProductRequest[]

  conversations        ConversationParticipant[]
  claimedConversations Conversation[]            @relation("ClaimedConversations")
  messages             Message[]
  activityLogs         ActivityLog[]

  // Agent/Lead management relations
  leadStatusHistories LeadStatusHistory[]
  callLogs            CallLog[]
  leadAssignments     LeadAssignment[]

  // Influencer relations
  referralLinks ReferralLink[]
  commissions   InfluencerCommission[]

  // Agent-Influencer assignment relations
  agentAssignments      AgentInfluencerAssignment[] @relation("AgentAssignments")
  influencerAssignments AgentInfluencerAssignment[] @relation("InfluencerAssignments")

  // Agent-Product assignment relations (narrows an assigned account to some of its products)
  agentProductAssignments      AgentProductAssignment[] @relation("AgentProductAssignments")
  influencerProductAssignments AgentProductAssignment[] @relation("InfluencerProductAssignments")

  // Helper-User assignment relations
  helperAssignments     HelperUserAssignment[] @relation("HelperAssignments")
  targetUserAssignments HelperUserAssignment[] @relation("TargetUserAssignments")

  orderStatusHistories  OrderStatusHistory[]
  productionJobs        ProductionJob[]
  favorites             Favorite[]
  targetedAnnouncements Announcement[]       @relation("TargetedAnnouncements")
  bankAccounts          UserBankAccount[]
  invoices              Invoice[]
  agentInvoices         AgentInvoice[]       @relation("AgentInvoices")
  conversationLogs      ConversationLog[]    @relation("UserLogs")
  pixels                UserPixel[]

  @@index([parentVendorId])
  @@map("users")
}

model UserBankAccount {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankName   String
  ribAccount String
  iceNumber  String?
  status     String   @default("PENDING") // PENDING, APPROVED, REJECTED
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("user_bank_accounts")
}

model UserProfile {
  userId    Int       @id
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName  String?
  avatarUrl String?
  city      String?
  address   String?
  cinNumber String?
  birthDate DateTime?
  language  String    @default("fr")
  metadata  Json?

  // Influencer Specific
  instagramUsername  String?
  instagramFollowers Int?
  tiktokUsername     String?
  facebookUsername   String?
  xUsername          String?
  youtubeUsername    String?
  snapchatUsername   String?

  @@map("user_profiles")
}

model KycDocument {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id])
  documentType String
  documentUrl  String
  status       String   @default("PENDING")
  metadata     Json?
  createdAt    DateTime @default(now())

  @@map("kyc_documents")
}

model Category {
  id       Int        @id @default(autoincrement())
  nameAr   String
  nameFr   String
  nameEn   String?
  parentId Int?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  slug     String     @unique
  imageUrl String?
  products Product[]

  @@map("categories")
}

model Product {
  id              Int     @id @default(autoincrement())
  sku             String  @unique
  ref             String? @unique // URL-friendly reference string
  nameAr          String
  nameFr          String
  nameEn          String?
  description     String?
  longDescription String? // Rich HTML content

  categories Category[] // Implicit M-To-M relation

  baseCostMad        Float
  retailPriceMad     Float
  affiliatePriceMad  Float?
  influencerPriceMad Float?
  isCustomizable     Boolean @default(true)
  minProductionDays  Int     @default(3)
  stockQuantity      Int     @default(0)
  stockStatus        String  @default("available") // "available", "out_of_stock", "pre_order"

  // Downloads and Links
  ficheTechniqueUrl String?
  canvaLink         String?
  mockupLink        String?

  // Arch modifications
  ownerId                 Int?
  owner                   User?    @relation("ProductOwner", fields: [ownerId], references: [id])
  visibility              String[] @default(["REGULAR"]) // REGULAR, AFFILIATE, INFLUENCER, NONE
  status                  String   @default("APPROVED") // PENDING, APPROVED, REJECTED
  videoUrls               String[] @default([])
  landingPageUrls         String[] @default([])
  commissionMad           Float    @default(0) // Affiliate commission per sale in MAD
  influencerCommissionMad Float    @default(0) // Influencer commission per sale in MAD

  isActive       Boolean  @default(true)
  showInHomepage Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  images                ProductImage[]
  orderItems            OrderItem[]
  inventories           ProductInventory[]
  warehouseInventories  Inventory[]
  claims                AffiliateClaim[]
  referralLinks         ReferralLink[]
  supportRequests       SupportRequest[]
  wholesalePrices       WholesalePriceTier[]
  favorites             Favorite[]
  agentAssignments      AgentProductAssignment[]
  subAccountAssignments VendorSubAccountProduct[]

  @@map("products")
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  imageUrl  String
  isPrimary Boolean @default(false)
  sortOrder Int     @default(0)

  @@map("product_images")
}

model WholesalePriceTier {
  id           Int      @id @default(autoincrement())
  productId    Int
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  minQuantity  Int
  maxQuantity  Int
  pricePerUnit Float
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("wholesale_price_tiers")
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@map("favorites")
}

model PlatformSettings {
  id        Int      @id @default(autoincrement())
  key       String   @unique // e.g. "site_name", "fees", "media"
  value     Json
  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

// Runtime-configurable environment values, managed by SUPER_ADMIN from the dashboard.
// `value` is always stored encrypted with ENCRYPTION_KEY (see utils/crypto.ts), even for
// non-secret entries, so a database dump never exposes provider credentials in plaintext.
// Bootstrap values (DATABASE_URL, ENCRYPTION_KEY, JWT_SECRET) are NEVER stored here —
// they are required before this table can be read. See config/secretRegistry.ts.
model AppSecret {
  id             Int      @id @default(autoincrement())
  key            String   @unique // matches the env var name, e.g. "COLIATY_SECRET_KEY"
  value          String // encrypted: "ENC:<iv>:<ciphertext>"
  updatedById    Int?
  updatedByEmail String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("app_secrets")
}

model LeadImportBatch {
  id            Int      @id @default(autoincrement())
  vendorId      Int
  vendor        User     @relation(fields: [vendorId], references: [id])
  fileName      String
  totalRows     Int      @default(0)
  validRows     Int      @default(0)
  duplicateRows Int      @default(0)
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())

  leads Lead[]

  @@map("lead_import_batches")
}

model Lead {
  id                    Int              @id @default(autoincrement())
  vendorId              Int
  vendor                User             @relation(fields: [vendorId], references: [id])
  importBatchId         Int?
  importBatch           LeadImportBatch? @relation(fields: [importBatchId], references: [id])
  fullName              String
  phone                 String
  whatsapp              String?
  city                  String?
  address               String?
  status                String           @default("NEW")
  paymentSituation      String           @default("NOT_PAID") // NOT_PAID, PAID, FACTURED
  source                String           @default("MANUAL") // MANUAL, YOUCAN, etc.
  sourceId              String? // External ID from YouCan or other systems
  sourceMode            String           @default("VENDOR") // VENDOR, AFFILIATE
  assignedAgentId       Int?
  assignedAgent         User?            @relation("AgentLeads", fields: [assignedAgentId], references: [id])
  productVariant        String?
  notes                 String?
  callbackAt            DateTime?
  // Amount the agent settled on during the confirmation call. Overrides the pack
  // price everywhere (see getPackPrice) and is what the courier collects. Null
  // means "no override — bill the pack".
  confirmedPriceMad     Float?
  requestedPriceMad     Float?
  requestedPriceStatus  String?          @default("PENDING") // PENDING, APPROVED, REJECTED
  customPlatformFeeRate Float?
  customShippingFee     Float?
  // Auto-release bookkeeping for the reassignment cron (jobs/leadReassignment).
  // `releaseAt` is rolled per lead when it enters a droppable status instead of
  // being derived from a fixed timeout, so an agent cannot learn the deadline
  // and park leads against it; it is also what the agent cards count down to.
  // `noReplyReleases` counts how many times NO_REPLY has actually sent this
  // lead back to the pool — at MAX_NO_REPLY_RELEASES it stops being recycled
  // and parks at DEAD_NO_REPLY. See lib/leadRelease.ts for both policies.
  releaseAt             DateTime?
  noReplyReleases       Int              @default(0)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  order             Order?
  referralLinkId    Int?
  referralLink      ReferralLink?           @relation(fields: [referralLinkId], references: [id])
  invoiceId         Int?
  invoice           Invoice?                @relation(fields: [invoiceId], references: [id])
  // The call-center side of the same parcel. Separate from `invoice` above,
  // which is the vendor's — see AgentInvoice for why the two cannot share it.
  agentInvoiceItem  AgentInvoiceItem?       @relation("AgentInvoiceItems")
  sheetPushJob      SheetPushJob?           @relation("SheetPushJobLead")
  sheetCreditCharge SheetCreditTransaction? @relation("SheetCreditCharge")
  statusHistory     LeadStatusHistory[]
  callLogs          CallLog[]
  assignments       LeadAssignment[]
  contactClicks     LeadContactClick[]

  // The reassignment cron re-runs this exact predicate every 10 seconds.
  @@index([status, releaseAt])
  // Postgres does not index foreign keys on its own. Without these, every lead
  // list (vendor dashboard, agent queue, /influencer/customers) sequentially
  // scanned the whole table and sorted it in memory. `vendorId, createdAt`
  // covers the filter and the ORDER BY together, which is the shape every
  // vendor-facing list uses.
  @@index([vendorId, createdAt])
  @@index([referralLinkId])
  @@index([assignedAgentId])
  @@index([createdAt])
  @@map("leads")
}

// Records each time an operator actually opened WhatsApp / dialled a lead, so
// contact attempts are auditable instead of living in one browser's localStorage.
model LeadContactClick {
  id        Int      @id @default(autoincrement())
  leadId    Int
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  channel   String // WHATSAPP, CALL
  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([leadId, channel])
  @@map("lead_contact_clicks")
}

model LeadStatusHistory {
  id        Int      @id @default(autoincrement())
  leadId    Int
  lead      Lead     @relation(fields: [leadId], references: [id])
  oldStatus String
  newStatus String
  changedBy Int
  changer   User     @relation(fields: [changedBy], references: [id])
  notes     String?
  createdAt DateTime @default(now())

  // Loaded as `WHERE leadId IN (...)` for a whole page of leads at a time.
  @@index([leadId])
  @@map("lead_status_history")
}

model CallLog {
  id                  Int      @id @default(autoincrement())
  leadId              Int
  lead                Lead     @relation(fields: [leadId], references: [id])
  agentId             Int
  agent               User     @relation(fields: [agentId], references: [id])
  callDurationSeconds Int?
  outcome             String // ANSWERED, NO_ANSWER, BUSY, etc.
  recordingUrl        String?
  notes               String?
  createdAt           DateTime @default(now())

  @@index([leadId])
  @@index([agentId])
  @@map("call_logs")
}

model LeadAssignment {
  id           Int       @id @default(autoincrement())
  leadId       Int
  lead         Lead      @relation(fields: [leadId], references: [id])
  agentId      Int
  agent        User      @relation(fields: [agentId], references: [id])
  assignedAt   DateTime  @default(now())
  unassignedAt DateTime?

  @@map("lead_assignments")
}

model Order {
  id                 Int      @id @default(autoincrement())
  orderNumber        String   @unique
  vendorId           Int
  vendor             User     @relation(fields: [vendorId], references: [id])
  leadId             Int?     @unique
  lead               Lead?    @relation(fields: [leadId], references: [id])
  customerName       String
  customerPhone      String
  customerCity       String
  customerAddress    String
  totalAmountMad     Float
  vendorEarningMad   Float
  platformFeeMad     Float
  status             String   @default("PENDING")
  paymentMethod      String   @default("COD")
  coliatyPackageCode String?
  coliatyPackageId   Int?
  coliatyPickupRef   String?
  packageContent     String?
  packageNoOpen      Boolean  @default(false)
  // Carried from the insert form all the way to Coliaty's parcel payload. They
  // used to live only inside the lead's free-text notes, so bulk-dispatch had
  // nothing to read and shipped every replacement as an ordinary new parcel.
  // Coliaty rejects a replacement whose old tracking number is missing, so the
  // two always travel together.
  packageReplacement Boolean  @default(false)
  packageOldTracking String?
  productVariant     String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  items                 OrderItem[]
  walletTransactions    WalletTransaction[]
  influencerCommissions InfluencerCommission[]
  statusHistory         OrderStatusHistory[]
  shipment              Shipment?
  returns               OrderReturn[]
  productionJobs        ProductionJob[]

  @@index([vendorId, createdAt])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id            Int     @id @default(autoincrement())
  orderId       Int
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     Int
  product       Product @relation(fields: [productId], references: [id])
  quantity      Int
  unitPriceMad  Float
  totalPriceMad Float

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderStatusHistory {
  id            Int      @id @default(autoincrement())
  orderId       Int
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  oldStatus     String?
  newStatus     String
  changedBy     Int
  changedByUser User     @relation(fields: [changedBy], references: [id])
  notes         String?
  createdAt     DateTime @default(now())

  @@index([orderId])
  @@map("order_status_history")
}

model Warehouse {
  id        Int               @id @default(autoincrement())
  name      String
  location  String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  batches   ProductionBatch[]
  inventory Inventory[]

  @@map("warehouses")
}

model ProductionBatch {
  id          Int             @id @default(autoincrement())
  batchNumber String          @unique
  warehouseId Int
  warehouse   Warehouse       @relation(fields: [warehouseId], references: [id])
  status      String          @default("PENDING")
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  jobs        ProductionJob[]

  @@map("production_batches")
}

model ProductionJob {
  id           Int             @id @default(autoincrement())
  batchId      Int
  batch        ProductionBatch @relation(fields: [batchId], references: [id])
  orderId      Int
  order        Order           @relation(fields: [orderId], references: [id])
  status       String          @default("PENDING")
  assignedTo   Int?
  assignedUser User?           @relation(fields: [assignedTo], references: [id])
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime        @default(now())

  @@map("production_jobs")
}

model Inventory {
  id               Int       @id @default(autoincrement())
  warehouseId      Int
  warehouse        Warehouse @relation(fields: [warehouseId], references: [id])
  productId        Int
  product          Product   @relation(fields: [productId], references: [id])
  quantity         Int       @default(0)
