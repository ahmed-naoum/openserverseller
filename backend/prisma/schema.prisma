model SessionRecording {
  id            String   @id @default(uuid())
  sessionId     String
  userUuid      String?
  ip            String
  userAgent     String?
  path          String?
  durationSec   Int      @default(0)
  eventDataGzip Bytes // Gzip compressed JSON string
  hasLead       Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([userUuid])
  @@index([createdAt])
  @@map("session_recordings")
}

/// Partial / abandoned checkout capture. Every keystroke on a referral checkout
/// updates this row; if the visitor never submits, `completed` stays false and
/// we keep the phone/name they typed so an agent can follow up on the lost lead.
model CheckoutAttempt {
  id              String    @id @default(uuid())
  sessionId       String    @unique // = socket.id, correlates with SessionRecording.sessionId
  referralCode    String?
  productName     String?
  ip              String
  userAgent       String?
  path            String?
  fullName        String?
  phone           String?
  city            String?
  address         String?
  fieldsFilled    Int       @default(0)
  completed       Boolean   @default(false)
  // Set when a call-center agent recovers this abandoned cart into a real Lead,
  // so it disappears from the agent's actionable list and can't be double-converted.
  convertedLeadId Int?
  convertedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([completed])
  @@index([ip])
  @@index([phone])
  @@index([createdAt])
  @@index([convertedLeadId])
  @@map("checkout_attempts")
}

/// Partial / abandoned SIGN-UP capture for /register. Mirrors CheckoutAttempt but
/// for the "I'm a Seller" / "I'm an Influencer" funnel: whatever the visitor typed
/// is kept even if they never finish, so an admin can follow up on the lost signup.
/// Passwords are NEVER captured.
model SignupAttempt {
  id           String   @id @default(uuid())
  sessionId    String   @unique // = socket.id
  role         String? // VENDOR | INFLUENCER
  fullName     String?
  email        String?
  phone        String?
  /// Highest wizard step the visitor reached (1..4).
  maxStep      Int      @default(1)
  fieldsFilled Int      @default(0)
  completed    Boolean  @default(false)
  ip           String
  userAgent    String?
  path         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([completed])
  @@index([role])
  @@index([email])
  @@index([phone])
  @@index([createdAt])
  @@map("signup_attempts")
}

/// Audit trail for every deployment triggered from the admin dashboard.
///
/// One row per attempt, including failures — a deploy that broke the site is
/// exactly the record you need afterwards. `logPath` points at the file the
/// detached runner streams into; the log survives the API process restarting.
model Deployment {
  id            String    @id @default(uuid())
  /// Commit the deploy moved the checkout to. Null when it failed before pulling.
  commitSha     String?
  commitMessage String?
  commitAuthor  String?
  branch        String    @default("master")
  /// PENDING | RUNNING | SUCCESS | FAILED | TIMEOUT
  status        String    @default("PENDING")
  /// WEBHOOK | MANUAL — how the deploy was started.
  trigger       String    @default("MANUAL")
  triggeredById Int?
  triggeredBy   String?
  exitCode      Int?
  errorMessage  String?
  logPath       String?
  startedAt     DateTime?
  finishedAt    DateTime?
  durationMs    Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([commitSha])
  @@map("deployments")
}

/// Commits seen via the GitHub webhook but not yet deployed.
///
/// Populated by the push webhook so the admin panel can show "3 commits waiting"
/// without calling the GitHub API on every page load. Rows are marked deployed
/// once a deployment that includes them succeeds.
model PendingCommit {
  id           String    @id @default(uuid())
  sha          String    @unique
  message      String
  author       String?
  branch       String
  url          String?
  committedAt  DateTime?
  deployed     Boolean   @default(false)
  deploymentId String?
  createdAt    DateTime  @default(now())

  @@index([deployed])
  @@index([branch])
  @@index([createdAt])
  @@map("pending_commits")
}
