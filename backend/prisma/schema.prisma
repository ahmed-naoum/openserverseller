model Invoice {
  id             Int      @id @default(autoincrement())
  invoiceNumber  String   @unique
  userId         Int
  user           User     @relation(fields: [userId], references: [id])
  totalAmountMad Float
  status         String   @default("PAID")
  createdAt      DateTime @default(now())

  leads Lead[]

  @@map("invoices")
}

// ---------------------------------------------------------------------------
// Call-center facturation
//
// What a *vendor* is billed for a lead already lives on `Invoice`, and a Lead
// carries a single `invoiceId` — so the agent's own billing cannot ride on that
// table without taking the lead away from the vendor's invoice. These two tables
// are the agent side of the same parcel, separate for exactly that reason.
//
// An agent is paid per parcel that actually reached the customer, so only a
// DELIVERED order is ever billable here.
// ---------------------------------------------------------------------------
model AgentInvoice {
  id            Int    @id @default(autoincrement())
  invoiceNumber String @unique
  agentId       Int
  agent         User   @relation("AgentInvoices", fields: [agentId], references: [id], onDelete: Cascade)

  // Snapshot of the rate at issue time. An admin can change `User.saisieFeeMad`
  // afterwards, and a settled invoice must not silently re-price itself.
  feePerParcelMad Float
  parcelCount     Int
  totalAmountMad  Float

  // PAID from the moment it is issued: issuing an invoice credits the agent's
  // wallet in the same transaction, so the money has genuinely moved. Admin
  // control sits one step later, on the payout request.
  status String @default("PAID")

  // Oldest and newest parcel on the invoice — the period it covers.
  periodFrom DateTime?
  periodTo   DateTime?
  paidAt     DateTime?
  createdAt  DateTime  @default(now())

  items AgentInvoiceItem[]

  @@index([agentId])
  @@map("agent_invoices")
}

model AgentInvoiceItem {
  id        Int          @id @default(autoincrement())
  invoiceId Int
  invoice   AgentInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  // Unique, and that is the whole idempotency guard: a delivered parcel can be
  // billed by its agent exactly once, no matter how often the page is clicked.
  leadId Int  @unique
  lead   Lead @relation("AgentInvoiceItems", fields: [leadId], references: [id], onDelete: Cascade)

  // What the agent earned on this parcel, and what the parcel itself was worth.
  // Both frozen here so an invoice reads the same after the order is edited.
  amountMad      Float
  parcelValueMad Float    @default(0)
  createdAt      DateTime @default(now())

  @@index([invoiceId])
  @@map("agent_invoice_items")
}

