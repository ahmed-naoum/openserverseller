# ============================================
# Silacod.ma - Frontend Environment Variables
# ============================================

# API Base URL (optional: if omitted, defaults to window.location.origin/api/v1 in production)
VITE_API_URL=http://localhost:3001/api/v1

# YouCan Integration Client ID (mandatory for YouCan OAuth integration)
VITE_YOUCAN_CLIENT_ID=2498

# Cloudflare Turnstile Site Key (optional: defaults to test keys in development)
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Google Client ID (for Google Sign-In)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
